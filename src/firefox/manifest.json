{
  "manifest_version": 3,
  "name": "Bitrix24 Быстрые ссылки",
  "description": "Универсальные быстрые ссылки для облачных и коробочных порталов Bitrix24.",
  "version": "1.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Bitrix24 Быстрые ссылки",
    "default_popup": "activate.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "b24-quick-links-v2@ostec-group.local",
      "strict_min_version": "121.0"
    }
  }
}
