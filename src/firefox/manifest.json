{
  "manifest_version": 3,
  "name": "Bitrix24 Быстрые ссылки",
  "description": "Быстрые ссылки с интерфейсом Bitrix24 для корпоративных порталов.",
  "version": "1.0",
  "permissions": [],
  "host_permissions": [
    "https://bitrix24.ostec-group.ru/*",
    "https://bitrix24test.ostec-group.ru/*",
    "https://bitrix24develop.ostec-group.ru/*",
    "https://bitrix24.selectica.ru/*",
    "https://bitrix24test.selectica.ru/*",
    "https://bitrix24develop.selectica.ru/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "b24-quick-links-v2@ostec-group.local",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://bitrix24.ostec-group.ru/*",
        "https://bitrix24test.ostec-group.ru/*",
        "https://bitrix24develop.ostec-group.ru/*",
        "https://bitrix24.selectica.ru/*",
        "https://bitrix24test.selectica.ru/*",
        "https://bitrix24develop.selectica.ru/*"
      ],
      "js": [
        "vendor/bxui-init.js",
        "vendor/ui.buttons.bundle.isolated.js",
        "vendor/bxui-button-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://bitrix24.ostec-group.ru/*",
        "https://bitrix24test.ostec-group.ru/*",
        "https://bitrix24develop.ostec-group.ru/*",
        "https://bitrix24.selectica.ru/*",
        "https://bitrix24test.selectica.ru/*",
        "https://bitrix24develop.selectica.ru/*"
      ],
      "css": [
        "vendor/ui.buttons.bundle.min.css",
        "vendor/ui.forms.min.css",
        "vendor/ui.counter.min.css",
        "vendor/ui.label.bundle.min.css",
        "vendor/ui.alerts.min.css",
        "styles.css",
        "bxui-skin.css"
      ],
      "js": [
        "settings.js",
        "recovery-settings.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
